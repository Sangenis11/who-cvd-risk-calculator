# === 2. Compute BMI (Rounded to whole number) ===
df["bmi"] = df["weight"] / (df["height"] / 100) ** 2
df["bmi"] = df["bmi"].replace([np.inf, -np.inf], np.nan)  # remove infinities
df["bmi"] = df["bmi"].round(0)  # round but keep as float for now
df["bmi"] = df["bmi"].fillna(0).astype(int)  # replace NaN with 0 (or another choice)

# === 3. Define helper functions ===
def get_age_band(age):
    if age < 40: return "40-44"
    elif age <= 44: return "40-44"
    elif age <= 49: return "45-49"
    elif age <= 54: return "50-54"
    elif age <= 59: return "55-59"
    elif age <= 64: return "60-64"
    elif age <= 69: return "65-69"
    else: return "70-74"

def get_bmi_band(bmi):
    if bmi < 20: return "<20"
    elif bmi < 25: return "20-24"
    elif bmi < 30: return "25-29"
    elif bmi < 35: return "30-34"
    else: return "≥35"

def get_sbp_band(sbp):
    if sbp < 120: return "<120"
    elif sbp < 140: return "120-139"
    elif sbp < 160: return "140-159"
    elif sbp < 180: return "160-179"
    else: return "≥180"


