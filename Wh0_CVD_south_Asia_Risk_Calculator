# === 5. Risk lookup function ===
def get_risk(age, gender, smoking, sbp, bmi):
    gender = str(gender).strip().lower()
    smoking = str(smoking).strip().lower()
    smoking = "yes" if smoking in ["yes", "1", "true"] else "no"

    a = get_age_band(age)
    b = get_sbp_band(sbp)
    c = get_bmi_band(bmi)

    idx = ["<20", "20-24", "25-29", "30-34", "≥35"].index(c)
    try:
        val = WHO_RISK[gender][smoking][a][b][idx]
    except KeyError:
        val = np.nan
    return val


# === 6. Apply risk calculation ===
df["crp_new"] = df.apply(lambda r: get_risk(r["age"], r["gender"], r["smoking"], r["bpsystole"], r["bmi"]), axis=1)

# === 7. Classify risk ===
def classify_risk(value):
    if pd.isna(value): return "Unknown"
    if value < 5: return "<5% (Low risk = Green)"
    elif value < 10: return "5–10% (Mild risk = Yellow)"
    elif value < 20: return "10–20% (Moderate risk = Orange)"
    elif value < 30: return "20–30% (High risk = Red)"
    else: return "≥30% (Very high risk = Dark Red)"

df["crp_new_class"] = df["crp_new"].apply(classify_risk)

